// Cove Backend - Prisma Schema
// 混合持久化架构：数据库存储索引和元数据，文件存储实际内容

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// 用户和项目
// ============================================

model User {
  id            String   @id
  username      String   @unique
  email         String   @unique
  displayName   String
  role          String
  status        String   @default("active") // active | suspended | deleted
  profilePath   String   // 指向 .cove/storage/users/{id}.json
  passwordHash  String?  // 密码哈希（可选，向后兼容）
  lastLoginAt   DateTime? // 最后登录时间
  failedLoginAttempts Int @default(0) // 登录失败次数
  lockedUntil   DateTime? // 账号锁定到期时间
  avatarUrl     String?  // 头像 URL（上传的文件路径或外部 URL）
  avatarType    String   @default("dicebear") // uploaded | dicebear | default
  createdAt     DateTime
  updatedAt     DateTime

  ownedProjects Project[] @relation("ProjectOwner")
  members       Member[]
  realmMemberships RealmMember[]

  @@index([username])
  @@index([email])
  @@index([role])
  @@index([status])
}

model Project {
  id          String   @id
  realmId     String   // ✅ Realm 隔离
  name        String
  description String?
  status      String
  ownerId     String
  metadataPath String  // 指向 .cove/storage/projects/{realmId}/{id}.json
  createdAt   DateTime
  updatedAt   DateTime

  realm       Realm     @relation(fields: [realmId], references: [id], onDelete: Cascade)
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  channels    Channel[]
  tasks       Task[]
  workflows   Workflow[]

  @@index([realmId])
  @@index([ownerId])
  @@index([status])
  @@index([realmId, status])
  @@unique([realmId, name])
}

// ============================================
// 频道和成员
// ============================================

model Channel {
  id            String   @id
  realmId       String   // ✅ Realm 隔离
  name          String
  displayName   String
  type          String   // public | private | dm
  status        String   // active | archived
  projectId     String?
  parentChannelId String?
  description   String?  // 频道描述
  icon          String?  // 频道图标
  membersData   String   @default("[]") // JSON array of member details (memberId, memberType, role, joinedAt)
  agentPool     String   @default("[]") // JSON array of agent IDs
  taskPool      String   @default("[]") // JSON array of task IDs
  conversationPool String @default("[]") // JSON array of conversation objects
  communicationRules String @default("{}") // JSON object of communication rules
  workspace     String   @default("{}") // JSON object of workspace config
  metaTags      String   @default("[]") // JSON array of tags
  metaCategory  String?  // 频道分类
  createdById   String   @default("system") // 创建者 ID
  createdByType String   @default("system") // 创建者类型 (user | agent | system)
  avatarUrl     String?  // 头像 URL（上传的文件路径或外部 URL）
  avatarType    String   @default("dicebear") // uploaded | dicebear | default
  messageCount  Int      @default(0)
  memberCount   Int      @default(0)
  createdAt     DateTime
  updatedAt     DateTime

  realm         Realm     @relation(fields: [realmId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id])
  parentChannel Channel?  @relation("ChannelThread", fields: [parentChannelId], references: [id])
  subChannels   Channel[] @relation("ChannelThread")
  members       Member[]
  messages      Message[]
  messageThreads Thread[]

  @@index([realmId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([parentChannelId])
  @@index([realmId, status])
  @@index([realmId, type])
  @@index([projectId, status])
  @@index([type, status])
  @@unique([realmId, name])
}

model Member {
  id          String   @id
  userId      String
  channelId   String
  role        String   // owner | admin | member
  status      String   // active | left | banned
  joinedAt    DateTime
  leftAt      DateTime?

  user        User     @relation(fields: [userId], references: [id])
  channel     Channel  @relation(fields: [channelId], references: [id])

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
  @@index([status])
}

// ============================================
// 消息
// ============================================

model Message {
  id            String   @id
  realmId       String   // ✅ Realm 隔离
  shortId       String   @unique  // M001, M002...
  channelId     String
  senderId      String
  senderType    String   // human | agent | system
  threadId      String?
  isThreadRoot  Boolean  @default(false)
  contentPath   String   // 指向 .cove/storage/messages/{realmId}/{id}.json
  contentType   String   // text | markdown | code | image | file
  status        String   // draft | sending | sent | failed | deleted
  isEdited      Boolean  @default(false)
  reactionCount Int      @default(0)
  replyCount    Int      @default(0)
  createdAt     DateTime
  updatedAt     DateTime
  deletedAt     DateTime?

  realm         Realm    @relation(fields: [realmId], references: [id], onDelete: Cascade)
  channel       Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  thread        Message? @relation("MessageThread", fields: [threadId], references: [id])
  replies       Message[] @relation("MessageThread")

  @@index([realmId])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([threadId])
  @@index([status])
  @@index([shortId])
  @@index([realmId, channelId])
  @@index([senderId, createdAt])
  @@index([status, createdAt])
}

// ============================================
// 任务和工作流
// ============================================

model Task {
  id          String   @id
  realmId     String   // ✅ Realm 隔离
  title       String
  description String?
  status      String   // todo | in_progress | blocked | done
  priority    String   // P0 | P1 | P2 | P3
  projectId   String
  channelId   String?
  assigneeId  String?
  detailsPath String   // 指向 .cove/storage/tasks/{realmId}/{id}.json
  createdAt   DateTime
  updatedAt   DateTime
  dueDate     DateTime?

  realm       Realm    @relation(fields: [realmId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id])

  @@index([realmId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([realmId, status])
  @@index([projectId, status, priority])
  @@index([assigneeId, status])
}

model Workflow {
  id          String   @id
  realmId     String   // ✅ Realm 隔离
  name        String
  type        String   // sequential | parallel | dag
  status      String   // draft | active | paused | completed
  projectId   String
  definitionPath String // 指向 .cove/storage/workflows/{realmId}/{id}.json
  createdAt   DateTime
  updatedAt   DateTime

  realm       Realm    @relation(fields: [realmId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id])

  @@index([realmId])
  @@index([projectId])
  @@index([status])
  @@index([realmId, status])
}

// ============================================
// Agent
// ============================================

model Agent {
  id          String   @id
  realmId     String   // ✅ Realm 隔离
  name        String
  displayName String
  status      String   // idle | active | disabled | error
  scope       String   @default("user") // built-in | user | project | admin
  projectIds  String   @default("[]") // JSON array of project IDs
  configPath  String   // 指向 .cove/storage/agents/{realmId}/{id}.json
  avatarUrl   String?  // 头像 URL（上传的文件路径或外部 URL）
  avatarType  String   @default("dicebear") // uploaded | dicebear | default
  createdBy   String   @default("system")
  createdAt   DateTime

  realm       Realm    @relation(fields: [realmId], references: [id], onDelete: Cascade)

  @@index([realmId])
  @@index([status])
  @@index([scope])
  @@index([name])
  @@index([createdBy])
  @@index([realmId, status])
  @@unique([realmId, name])
}

// ============================================
// 附件
// ============================================

model Attachment {
  id          String   @id
  realmId     String   // ✅ Realm 隔离
  messageId   String?
  fileName    String
  fileSize    Int
  mimeType    String
  filePath    String   // 指向 .cove/storage/attachments/{realmId}/{id}.{ext}
  uploadedBy  String
  createdAt   DateTime

  realm       Realm    @relation(fields: [realmId], references: [id], onDelete: Cascade)

  @@index([realmId])
  @@index([messageId])
  @@index([uploadedBy])
  @@index([realmId, messageId])
}

// ============================================
// 线程
// ============================================

model Thread {
  id            String   @id
  realmId       String   // ✅ Realm 隔离
  channelId     String
  rootMessageId String   @unique
  participants  String   // JSON array of user IDs
  replyCount    Int      @default(0)
  detailsPath   String   // 指向 .cove/storage/threads/{realmId}/{id}.json
  lastReplyAt   DateTime?
  createdAt     DateTime
  updatedAt     DateTime

  realm         Realm    @relation(fields: [realmId], references: [id], onDelete: Cascade)
  channel       Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([realmId])
  @@index([channelId])
  @@index([rootMessageId])
  @@index([realmId, channelId])
}

// ============================================
// 服务器和设备
// ============================================

model Realm {
  id          String   @id
  name        String   @unique
  displayName String
  description String?
  ownerId     String
  status      String   // active, archived
  visibility  String   // public, private
  settings    String   // JSON: { allow_invites, require_approval, default_channel_id }
  limits      String   // JSON: { max_members, max_channels, max_agents }
  meta        String?  // JSON: { tags, icon, banner }
  logoUrl     String?  // Logo URL（上传的文件路径或外部 URL）
  logoType    String   @default("dicebear") // uploaded | dicebear | default
  createdAt   DateTime
  updatedAt   DateTime

  members     RealmMember[]
  devices     Device[]
  projects    Project[]     // ✅ 新增
  agents      Agent[]       // ✅ 新增
  channels    Channel[]     // ✅ 新增
  messages    Message[]     // ✅ 新增
  threads     Thread[]      // ✅ 新增
  attachments Attachment[]  // ✅ 新增
  tasks       Task[]        // ✅ 新增
  workflows   Workflow[]    // ✅ 新增

  @@index([name])
  @@index([ownerId])
  @@index([status])
}

model RealmMember {
  id                String   @id
  realmId          String   @map("realm_id")
  userId            String   @map("user_id")
  role              String   // owner | admin | member | guest
  customPermissions String?  @map("custom_permissions") // JSON array
  status            String   @default("active") // active | suspended | left
  joinedAt          DateTime @map("joined_at")
  updatedAt         DateTime @map("updated_at")
  meta              String?  // JSON object

  realm Realm @relation(fields: [realmId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([realmId, userId])
  @@index([realmId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("realm_members")
}

model Device {
  id          String   @id
  realmId    String   @unique
  name        String
  displayName String?
  type        String   // desktop, mobile, tablet, server, iot
  status      String   // provisioning, online, offline, maintenance, decommissioned
  platform    String?  // darwin, linux, windows, ios, android
  configPath  String   // 指向 .cove/storage/devices/{id}.json
  lastSeenAt  DateTime?
  createdAt   DateTime
  updatedAt   DateTime

  // 🔒 认证字段
  apiKeyHash  String?  // API Key 哈希值（bcrypt）

  // 📊 任务调度字段
  activeTaskCount     Int     @default(0)  // 当前执行任务数
  totalTasksExecuted  Int     @default(0)  // 累计执行任务数
  averageTaskDuration Float?  // 平均任务执行时间（秒）
  lastExecutedAgentId String? // 最后执行的 Agent ID（用于亲和性调度）

  // 🏷️ 调度标签
  region              String? // 地域标签
  tags                String  @default("[]") // JSON array of tags

  // 📈 资源使用
  cpuUsage            Float?  // CPU 使用率 0-100
  memoryUsage         Float?  // 内存使用率 0-100

  realm       Realm    @relation(fields: [realmId], references: [id], onDelete: Cascade)

  @@index([realmId])
  @@index([name])
  @@index([status])
  @@index([type])
  @@index([apiKeyHash])
  @@index([realmId, status])
  @@unique([realmId, name])
}

// ============================================
// 审计日志
// ============================================

model AuditLog {
  id            String   @id
  userId        String   // 执行操作的用户 ID
  action        String   // create, update, delete, login, logout, etc.
  resourceType  String   // user, channel, message, project, etc.
  resourceId    String?  // 被操作资源的 ID
  details       String?  // JSON string with operation details
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([resourceId])
  @@index([createdAt])
}

// ============================================
// 消息编排存储层
// ============================================

model MessageTask {
  id              String   @id
  messageId       String
  channelId       String
  content         String
  state           String   // PENDING | PROCESSING | COMPLETED | FAILED | DEAD_LETTER
  executionMode   String   // backend | device
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  priority        Int      @default(0)
  error           String?
  createdAt       DateTime
  updatedAt       DateTime
  lastAttemptAt   DateTime?
  completedAt     DateTime?

  @@index([state])
  @@index([priority])
  @@index([messageId])
  @@index([state, priority])
  @@index([createdAt])
}

model FeatureFlagConfig {
  realmId           String   @id
  flagName          String
  enabled           Boolean
  mode              String   // backend | device
  rolloutPercentage Int      @default(0)
  createdAt         DateTime
  updatedAt         DateTime

  @@index([enabled])
  @@index([mode])
}

model ConfigCache {
  realmId     String   @id
  version     Int
  config      String   // JSON string
  checksum    String
  createdAt   DateTime
  updatedAt   DateTime

  @@index([version])
}

model ProgressRecord {
  id          String   @id
  taskId      String
  progress    Int      // 0-100
  status      String   // running | completed | failed
  data        String?  // JSON string
  createdAt   DateTime
  updatedAt   DateTime

  @@index([taskId])
  @@index([status])
}
