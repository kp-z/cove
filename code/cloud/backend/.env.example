# LLM Provider: "anthropic" | "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Common
LLM_MAX_TOKENS=4096

# Database
# Use absolute path to .cove/storage/cove.db for unified data directory
DATABASE_URL=file:/Users/YOUR_USERNAME/.cove/storage/cove.db

# Server
PORT=3002
