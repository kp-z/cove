{
  "version": "1.0",
  "type": "backend",
  "runtime": {
    "type": "node",
    "version": "20"
  },
  "build": {
    "command": "cd backend && npm run build:esbuild",
    "outputDir": "backend/dist"
  },
  "start": {
    "command": "node backend/dist/bundle.js",
    "port": 3002
  },
  "health": {
    "endpoint": "/health",
    "timeout": 30
  },
  "env": {
    "NODE_ENV": "production",
    "DATABASE_URL": "file:./data/cove.db"
  }
}
