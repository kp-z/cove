{
  "version": "1.0",
  "type": "backend",
  "runtime": {
    "type": "node",
    "version": "20"
  },
  "build": {
    "command": "cd code/cloud/backend && npm run build:esbuild",
    "outputDir": "code/cloud/backend/dist"
  },
  "start": {
    "command": "node dist/bundle.js",
    "port": 3002
  },
  "health": {
    "endpoint": "/health",
    "timeout": 30
  },
  "env": {
    "NODE_ENV": "production",
    "DATABASE_URL": "file:./data/cove.db",
    "JWT_SECRET": "dev-secret-change-in-production-12345678901234567890",
    "PORT": "3002"
  }
}
