{
  "version": "1.0",
  "type": "frontend",
  "runtime": {
    "type": "node",
    "version": "20"
  },
  "build": {
    "command": "cd code/cloud/frontend && npm run build",
    "outputDir": "code/cloud/frontend/dist"
  },
  "serve": {
    "type": "static",
    "spa": true,
    "port": 6173
  },
  "env": {
    "VITE_API_URL": "http://localhost:4002"
  }
}
