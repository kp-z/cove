FROM node:20-alpine

WORKDIR /app

# Copy build output
COPY backend/dist ./dist
COPY backend/package.json ./
COPY backend/prisma ./prisma

# Install production dependencies
RUN npm install --production

# Generate Prisma client
RUN npx prisma generate

# Expose port
EXPOSE 3002

# Start command
CMD ["node","dist/bundle.js"]