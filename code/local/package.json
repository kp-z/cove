{
  "name": "@cove/local-device",
  "version": "0.1.0",
  "description": "Cove Local Agent - Connect your local machine to Cove Cloud",
  "main": "dist/main.js",
  "bin": {
    "cove-local-device": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cove",
    "agent",
    "local",
    "ai",
    "automation"
  ],
  "author": "Cove Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kp-z/cove.git",
    "directory": "code/local"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts --",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:watch": "vitest tests/e2e",
    "test:device-client": "vitest run src/__tests__/device-client.integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@prisma/client": "^6.1.0",
    "@trpc/client": "^10.45.0",
